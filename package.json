{
    "name": "face-liveness-detection",
    "version": "1.1.0",
    "description": "A frontend-only solution for face liveness detection using MediaPipe Face Mesh, with anti-camera-shake protection and face area guidance",
    "main": "dist/face-liveness-detection.umd.js",
    "module": "dist/face-liveness-detection.es.js",
    "types": "src/js/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/face-liveness-detection.es.js",
            "require": "./dist/face-liveness-detection.umd.js",
            "types": "./src/js/index.d.ts"
        }
    },
    "files": [
        "dist",
        "src/js/index.d.ts",
        "src/css/*.css"
    ],
    "scripts": {
        "dev": "vite --mode demo",
        "build": "vite build",
        "build:demo": "vite build --mode demo",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "face",
        "liveness",
        "detection",
        "mediapipe",
        "face-mesh",
        "blink",
        "活体检测",
        "人脸识别"
    ],
    "author": "",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/aliujun/face-liveness-detection"
    },
    "peerDependencies": {
        "@mediapipe/camera_utils": "^0.3.0",
        "@mediapipe/face_mesh": "^0.4.0"
    },
    "devDependencies": {
        "vite": "^5.4.8"
    },
    "dependencies": {
        "@mediapipe/camera_utils": "^0.3.0",
        "@mediapipe/face_mesh": "^0.4.0",
        "@mediapipe/tasks-vision": "^0.10.35"
    },
    "overrides": {
        "vite": "^5.4.8",
        "nanoid": "^3.3.8",
        "postcss": "^8.5.0"
    }
}
